diff --git a/adapters/windows/isolated_input.rs b/adapters/windows/isolated_input.rs
index 9d7fc96..1a26b2e 100644
--- a/adapters/windows/isolated_input.rs
+++ b/adapters/windows/isolated_input.rs
@@ -1243,4 +1243,64 @@ mod tests {
         assert_eq!(local.document.borrow().as_str(), expected);
         assert_eq!(local.host.engine.borrow().frame().preedit, "");
     }
+
+    #[test]
+    fn selection_proof_is_returned_only_after_applied_and_retry_has_new_identity() {
+        let local = scheme_local();
+        type_text(&local, "nihao");
+        let (_, rejected) = local
+            .process(InputEvent::Key(Key::Space), None, &|_| {
+                CommitOutcome::NotApplied
+            })
+            .unwrap();
+        assert!(rejected.selection.is_none());
+        let failed = local
+            .host
+            .engine
+            .borrow()
+            .pending_selection()
+            .unwrap()
+            .clone();
+        assert!(local.document.borrow().is_empty());
+        let (_, applied) = local
+            .process(InputEvent::RetryCommit, None, &|_| CommitOutcome::Applied)
+            .unwrap();
+        let selected = applied.selection.unwrap();
+        assert_ne!(selected.commit_id, failed.commit_id);
+        assert_eq!(selected.entries, failed.entries);
+        assert_eq!(selected.candidate_id, failed.candidate_id);
+        assert!(local.host.engine.borrow().pending_selection().is_none());
+        let before = local.document.borrow().clone();
+        assert!(
+            local
+                .process(
+                    InputEvent::CommitSucceeded {
+                        id: failed.commit_id
+                    },
+                    None,
+                    &|_| { panic!("迟到确认不能再次调用写入端") }
+                )
+                .is_err()
+        );
+        assert_eq!(*local.document.borrow(), before);
+
+        let unknown = scheme_local();
+        type_text(&unknown, "nihao");
+        let (_, uncertain) = unknown
+            .process(InputEvent::Key(Key::Space), None, &|_| {
+                CommitOutcome::Unknown
+            })
+            .unwrap();
+        assert!(uncertain.selection.is_none());
+        assert!(unknown.host.quarantined.get());
+        assert!(unknown.document.borrow().is_empty());
+        assert!(
+            unknown
+                .process(InputEvent::RetryCommit, None, &|_| {
+                    panic!("Unknown不能自动重放或产生学习凭据")
+                })
+                .is_err()
+        );
+        assert!(unknown.retained.borrow().contains("nihao"));
+    }
 }
diff --git a/adapters/windows/user_worker_tests.rs b/adapters/windows/user_worker_tests.rs
index 9e89866..7b8d638 100644
--- a/adapters/windows/user_worker_tests.rs
+++ b/adapters/windows/user_worker_tests.rs
@@ -197,3 +197,94 @@ fn actual_worker_persists_user_candidates_and_gates_learning_across_restart() {
     assert_eq!(directory.parent().unwrap().canonicalize().unwrap(), temp);
     std::fs::remove_dir_all(directory).unwrap();
 }
+
+#[test]
+fn full_worker_queues_refuse_more_work_and_shutdown_releases_the_actual_store_lock() {
+    let temp = std::env::temp_dir().canonicalize().unwrap();
+    let directory = temp.join(format!(
+        "cloudleaf-r20-backpressure-{}-{}",
+        std::process::id(),
+        SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos()
+    ));
+    std::fs::create_dir(&directory).unwrap();
+    let base = Arc::new(SearchSnapshot::from_verified_tsv(BASE, BASE_SHA).unwrap());
+    let mut worker = Worker::start(base, None, directory.clone());
+    drop(ready(&worker));
+    let mut accepted = 0;
+    let mut refused = false;
+    // 不消费真实结果队列，worker最终在有界回传处等待；派发仍只能try_send。
+    for _ in 0..64 {
+        match worker.send(Work::Manage(user_panel::Command::Save)) {
+            Ok(()) => accepted += 1,
+            Err(_) => {
+                refused = true;
+                break;
+            }
+        }
+    }
+    assert!(refused && accepted > 0);
+    worker.shutdown();
+    let mut store = Store::open(directory.clone()).unwrap();
+    assert_eq!(store.load().unwrap().generation(), accepted);
+    drop(store);
+    assert_eq!(directory.parent().unwrap().canonicalize().unwrap(), temp);
+    std::fs::remove_dir_all(directory).unwrap();
+}
+
+#[test]
+fn invalid_import_preserves_the_saved_user_layer_and_worker_remains_usable() {
+    let temp = std::env::temp_dir().canonicalize().unwrap();
+    let directory = temp.join(format!(
+        "cloudleaf-r20-import-{}-{}",
+        std::process::id(),
+        SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos()
+    ));
+    std::fs::create_dir(&directory).unwrap();
+    let invalid = directory.join("own-invalid-fixture.tsv");
+    std::fs::write(&invalid, b"invalid package").unwrap();
+    let base = Arc::new(SearchSnapshot::from_verified_tsv(BASE, BASE_SHA).unwrap());
+    let mut worker = Worker::start(base, None, directory.clone());
+    drop(ready(&worker));
+    worker
+        .send(Work::Manage(user_panel::Command::Add {
+            text: "云笺".into(),
+            pinyin: "yun jian".into(),
+        }))
+        .unwrap();
+    let saved = ready(&worker);
+    let generation = saved.generation;
+    let version = saved.snapshot.version().to_owned();
+    drop(saved);
+    worker
+        .send(Work::Manage(user_panel::Command::Import {
+            path: invalid.to_string_lossy().into_owned(),
+        }))
+        .unwrap();
+    assert!(matches!(receive(&worker), Reply::Error(_)));
+    worker
+        .send(Work::Manage(user_panel::Command::Reload))
+        .unwrap();
+    let reloaded = ready(&worker);
+    assert_eq!(reloaded.generation, generation);
+    assert_eq!(reloaded.snapshot.version(), version);
+    assert!(
+        reloaded
+            .snapshot
+            .entries()
+            .iter()
+            .any(|entry| entry.id == "user:1")
+    );
+    drop(reloaded);
+    worker.shutdown();
+    let mut store = Store::open(directory.clone()).unwrap();
+    assert_eq!(store.load().unwrap().generation(), generation);
+    drop(store);
+    assert_eq!(directory.parent().unwrap().canonicalize().unwrap(), temp);
+    std::fs::remove_dir_all(directory).unwrap();
+}
