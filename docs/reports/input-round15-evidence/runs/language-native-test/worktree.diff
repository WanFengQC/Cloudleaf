+impl LanguageSnapshot {
+    pub fn from_verified_tsv(
+        text: &str,
+        expected_sha256: &str,
+        lexicon: &SearchSnapshot,
+    ) -> Result<Self, CoreError> {
+        let version = hex(digest(&SHA256, text.as_bytes()).as_ref());
