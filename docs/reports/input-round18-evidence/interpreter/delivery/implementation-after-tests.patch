+mod tests {
+    use super::*;
+    #[test]
+    fn official_rules_and_independently_worked_examples() {
+        for (syllable, expected) in [
+            ("a", "aa"),
+            ("e", "ee"),
+            ("o", "oo"),
+            ("ai", "ai"),
+            ("an", "an"),
+            ("ao", "ao"),
+            ("ei", "ei"),
+            ("en", "en"),
+            ("er", "er"),
+            ("ou", "ou"),
+            ("ang", "ah"),
+            ("eng", "eg"),
+            ("zhong", "vs"),
+            ("chong", "is"),
+            ("shuang", "ul"),
+            ("ni", "ni"),
+            ("hao", "hc"),
+            ("pin", "pb"),
+            ("nv", "nv"),
+            ("lv", "lv"),
+            ("nve", "nt"),
+            ("lve", "lt"),
+            ("xue", "xt"),
+            ("ju", "ju"),
+            ("qu", "qu"),
+            ("xu", "xu"),
+            ("yu", "yu"),
+            ("juan", "jr"),
+            ("jun", "jy"),
+            ("yi", "yi"),
+            ("yin", "yb"),
+            ("ying", "yk"),
+            ("wo", "wo"),
+            ("yong", "ys"),
+            ("wen", "wf"),
+        ] {
+            assert_eq!(
+                xiaohe_code(syllable).map(|v| String::from_utf8(v.to_vec()).unwrap()),
