+//! 小鹤纯双拼事实键位的独立实现；不包含原输入法核心、形码或词库。
+
+pub const XIAOHE_LAYOUT_VERSION: &str = "xiaohe-flypy-up-2026-09-27-v1";
+
+pub const XIAOHE_INITIALS: &[(&str, u8)] = &[("zh", b'v'), ("ch", b'i'), ("sh", b'u')];
+pub const XIAOHE_FINALS: &[(&str, u8)] = &[
+    ("a", b'a'),
+    ("ai", b'd'),
+    ("an", b'j'),
+    ("ang", b'h'),
+    ("ao", b'c'),
+    ("e", b'e'),
