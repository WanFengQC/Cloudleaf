+            );
+        }
+    }
+    #[test]
+    fn key_table_has_unique_final_rows_and_ascii_letter_codes() {
+        for (i, (final_, key)) in XIAOHE_FINALS.iter().enumerate() {
+            assert!(key.is_ascii_lowercase());
+            assert!(!XIAOHE_FINALS[..i].iter().any(|(other, _)| other == final_));
+        }
+    }
+}
